<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<key>CFBundleDisplayName</key>
	<string>FallApp</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>fallapp</string>
			</array>
		</dict>
	</array>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>LSSupportsOpeningDocumentsInPlace</key>
	<true/>
	<key>MWDAT</key>
	<dict>
		<key>AppLinkURLScheme</key>
		<string>fallapp://</string>
		<key>ClientToken</key>
		<string>$(CLIENT_TOKEN)</string>
		<key>MetaAppID</key>
		<string>$(META_APP_ID)</string>
		<key>TeamID</key>
		<string>$(DEVELOPMENT_TEAM)</string>
	</dict>
	<key>ModalAuthMode</key>
	<string>$(MODAL_AUTH_MODE)</string>
	<key>ModalEndpointURL</key>
	<string>$(MODAL_ENDPOINT_URL)</string>
	<key>NSBluetoothAlwaysUsageDescription</key>
	<string>Connect to your Meta glasses for local fall monitoring.</string>
	<key>NSBonjourServices</key>
	<array>
		<string>_bonjour._tcp</string>
	</array>
	<key>NSCameraUsageDescription</key>
	<string>Capture one-second image bursts from your glasses after a fall alert.</string>
	<key>NSLocalNetworkUsageDescription</key>
	<string>Connect to your Meta glasses over the local network.</string>
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>Include your timestamped phone location in a fall alert email to your emergency contact.</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>Hear your reply through the glasses microphone after a server-confirmed fall.</string>
	<key>NSSpeechRecognitionUsageDescription</key>
	<string>Transcribe your spoken check-in reply and send its text to your fall-monitoring server for analysis.</string>
	<key>UIBackgroundModes</key>
	<array>
		<string>bluetooth-central</string>
		<string>bluetooth-peripheral</string>
		<string>external-accessory</string>
		<string>audio</string>
	</array>
	<key>UIFileSharingEnabled</key>
	<true/>
	<key>UILaunchScreen</key>
	<dict/>
	<key>UISupportedExternalAccessoryProtocols</key>
	<array>
		<string>com.meta.ar.wearable</string>
	</array>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>
	<key>UIUserInterfaceStyle</key>
	<string>Light</string>
</dict>
</plist>
